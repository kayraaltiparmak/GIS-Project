<?xml version="1.0" encoding="UTF-8"?>
<sld:StyledLayerDescriptor version="1.0.0" xmlns:sld="http://www.opengis.net/sld" xmlns:ogc="http://www.opengis.net/ogc" xmlns:xlink="http://www.w3.org/1999/xlink">
<sld:NamedLayer><sld:Name>poi_category_style</sld:Name><sld:UserStyle><sld:FeatureTypeStyle>
  <!-- SVG dosyalarını GeoServer workspace styles/poi-icons klasörüne kopyalayın. -->
  <sld:Rule><sld:Name>pharmacy</sld:Name><ogc:Filter><ogc:PropertyIsEqualTo><ogc:PropertyName>IconKey</ogc:PropertyName><ogc:Literal>pharmacy</ogc:Literal></ogc:PropertyIsEqualTo></ogc:Filter><sld:PointSymbolizer><sld:Graphic><sld:ExternalGraphic><sld:OnlineResource xlink:type="simple" xlink:href="poi-icons/pharmacy.svg"/><sld:Format>image/svg+xml</sld:Format></sld:ExternalGraphic><sld:Size>36</sld:Size></sld:Graphic></sld:PointSymbolizer></sld:Rule>
  <sld:Rule><sld:Name>cafe</sld:Name><ogc:Filter><ogc:PropertyIsEqualTo><ogc:PropertyName>IconKey</ogc:PropertyName><ogc:Literal>cafe</ogc:Literal></ogc:PropertyIsEqualTo></ogc:Filter><sld:PointSymbolizer><sld:Graphic><sld:ExternalGraphic><sld:OnlineResource xlink:type="simple" xlink:href="poi-icons/cafe.svg"/><sld:Format>image/svg+xml</sld:Format></sld:ExternalGraphic><sld:Size>36</sld:Size></sld:Graphic></sld:PointSymbolizer></sld:Rule>
  <sld:Rule><sld:Name>restaurant</sld:Name><ogc:Filter><ogc:PropertyIsEqualTo><ogc:PropertyName>IconKey</ogc:PropertyName><ogc:Literal>restaurant</ogc:Literal></ogc:PropertyIsEqualTo></ogc:Filter><sld:PointSymbolizer><sld:Graphic><sld:ExternalGraphic><sld:OnlineResource xlink:type="simple" xlink:href="poi-icons/restaurant.svg"/><sld:Format>image/svg+xml</sld:Format></sld:ExternalGraphic><sld:Size>36</sld:Size></sld:Graphic></sld:PointSymbolizer></sld:Rule>
  <sld:Rule><sld:Name>hospital</sld:Name><ogc:Filter><ogc:PropertyIsEqualTo><ogc:PropertyName>IconKey</ogc:PropertyName><ogc:Literal>hospital</ogc:Literal></ogc:PropertyIsEqualTo></ogc:Filter><sld:PointSymbolizer><sld:Graphic><sld:ExternalGraphic><sld:OnlineResource xlink:type="simple" xlink:href="poi-icons/hospital.svg"/><sld:Format>image/svg+xml</sld:Format></sld:ExternalGraphic><sld:Size>36</sld:Size></sld:Graphic></sld:PointSymbolizer></sld:Rule>
  <sld:Rule><sld:Name>school</sld:Name><ogc:Filter><ogc:PropertyIsEqualTo><ogc:PropertyName>IconKey</ogc:PropertyName><ogc:Literal>school</ogc:Literal></ogc:PropertyIsEqualTo></ogc:Filter><sld:PointSymbolizer><sld:Graphic><sld:ExternalGraphic><sld:OnlineResource xlink:type="simple" xlink:href="poi-icons/school.svg"/><sld:Format>image/svg+xml</sld:Format></sld:ExternalGraphic><sld:Size>36</sld:Size></sld:Graphic></sld:PointSymbolizer></sld:Rule>
  <sld:Rule><sld:Name>market</sld:Name><ogc:Filter><ogc:PropertyIsEqualTo><ogc:PropertyName>IconKey</ogc:PropertyName><ogc:Literal>market</ogc:Literal></ogc:PropertyIsEqualTo></ogc:Filter><sld:PointSymbolizer><sld:Graphic><sld:ExternalGraphic><sld:OnlineResource xlink:type="simple" xlink:href="poi-icons/market.svg"/><sld:Format>image/svg+xml</sld:Format></sld:ExternalGraphic><sld:Size>36</sld:Size></sld:Graphic></sld:PointSymbolizer></sld:Rule>
  <sld:Rule><sld:Name>default</sld:Name><sld:ElseFilter/><sld:PointSymbolizer><sld:Graphic><sld:ExternalGraphic><sld:OnlineResource xlink:type="simple" xlink:href="poi-icons/default.svg"/><sld:Format>image/svg+xml</sld:Format></sld:ExternalGraphic><sld:Size>36</sld:Size></sld:Graphic></sld:PointSymbolizer></sld:Rule>
  <sld:Rule><sld:Name>close_zoom_labels</sld:Name><sld:MaxScaleDenominator>70000</sld:MaxScaleDenominator><sld:TextSymbolizer><sld:Label><ogc:PropertyName>Name</ogc:PropertyName></sld:Label><sld:Font><sld:CssParameter name="font-family">Arial</sld:CssParameter><sld:CssParameter name="font-size">12</sld:CssParameter><sld:CssParameter name="font-weight">bold</sld:CssParameter></sld:Font><sld:LabelPlacement><sld:PointPlacement><sld:Displacement><sld:DisplacementX>0</sld:DisplacementX><sld:DisplacementY>24</sld:DisplacementY></sld:Displacement></sld:PointPlacement></sld:LabelPlacement><sld:Halo><sld:Radius>2</sld:Radius><sld:Fill><sld:CssParameter name="fill">#ffffff</sld:CssParameter></sld:Fill></sld:Halo><sld:Fill><sld:CssParameter name="fill">#111827</sld:CssParameter></sld:Fill></sld:TextSymbolizer></sld:Rule>
</sld:FeatureTypeStyle></sld:UserStyle></sld:NamedLayer></sld:StyledLayerDescriptor>
